<Page x:Class="Pract_SQL3.Pages.LKPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pract_SQL3.Pages"
      mc:Ignorable="d" 
            d:DesignHeight="450" d:DesignWidth="800"
      Title="LKPage" Background="White" IsVisibleChanged = "Page_IsVisibleChanged">

    <Grid>

        <Grid.RowDefinitions>
            
            <RowDefinition Height="80"/>
            <RowDefinition Height="80"/>
            <RowDefinition/>
            
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Fio,StringFormat='Привет {0}'}"></TextBlock>
            <Button Content="Exit" Background="Transparent" BorderBrush="Transparent" Foreground="White" FontSize="25" Click="Exit">
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="1">
        <TextBlock  Text="Ваши заказы" FontSize="40" HorizontalAlignment="Center"/>
            <Button Click="AddOrder"> добавить</Button>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ListView x:Name="OrderList"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      MouseDoubleClick="OrderList_MouseDoubleClick"
                      HorizontalContentAlignment="Center">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="15" BorderBrush="LightGray" BorderThickness="1" CornerRadius="10" Width="350">
                            <StackPanel>
                                <TextBlock Text="{Binding Id, StringFormat='Заказ №{0}'}" FontSize="18" FontWeight="Bold" Foreground="#333"/>
                                <TextBlock Text="{Binding OrderDate, StringFormat='Дата: {0:dd.MM.yyyy}'}" Margin="0,5" Foreground="#555"/>
                                <TextBlock Text="{Binding TotalPrice, StringFormat='Сумма: {0} руб.'}" Margin="0,5" FontWeight="Bold" Foreground="#2c3e50"/>
                                <TextBlock Text="{Binding Status}" Margin="0,5" FontWeight="Bold" Foreground="#2c3e50"/>

                                <ItemsControl ItemsSource="{Binding OrderItem}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Tovar.Name}" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat='шт {0}'}" Margin="10,0,0,0" FontWeight="Bold"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

    </Grid>
</Page>
