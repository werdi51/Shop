<Page x:Class="Pract_SQL3.Pages.AddTovar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pract_SQL3.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddTovar">

    <Grid>
        <StackPanel HorizontalAlignment="Center" Width="400" VerticalAlignment="Center">
            
            <StackPanel >
                <Label FontSize="30">Название</Label >
                <TextBox Text="{Binding Name}" FontSize="30"></TextBox>
            </StackPanel>

            <StackPanel >
                <Label FontSize="30">Описание</Label>
                <TextBox Text="{Binding Description}" FontSize="30"></TextBox>
            </StackPanel>

            <StackPanel >
                <Label FontSize="30">Цена</Label>
                <TextBox Text="{Binding Price}" FontSize="30"></TextBox>
            </StackPanel>

            <StackPanel >
                <Label FontSize="30">Количество</Label>
                <TextBox Text="{Binding Count}" FontSize="30"></TextBox>
            </StackPanel>

            <Button Name="Add_Tovar" Click="Add_Tovar_Click" Content="Добавить товар" Height="50" Margin="20" Background="Aquamarine" FontSize="30"/>

        </StackPanel>
    </Grid>
</Page>
